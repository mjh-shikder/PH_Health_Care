{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!src/app/templates",
			"!src/generated"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn"
			},
			"complexity":{
				"noCommaOperator": "info"
			},
			"correctness":{
				"noUnusedFunctionParameters": "off",
				"noUnusedImports": "off",
				"noUnusedVariables": "info",
				

			
			},
			"style":{
				"noNonNullAssertion": "info",
				"useNodejsImportProtocol": "info",
				"useImportType": "off"
			}
		},
		"includes": [
			"**",
			"!src/app/templates",
			"!src/generated"
		]
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
