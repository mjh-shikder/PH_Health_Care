<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Password Reset Successful</title>
    <style>
      body {
        margin: 0;
        padding: 32px 16px;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, #ecfdf5 0%, #f8fafc 100%);
        color: #111827;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        border: 1px solid #e5e7eb;
      }

      .header {
        padding: 32px 32px 18px;
        background: linear-gradient(135deg, #14532d 0%, #16a34a 100%);
        color: #ffffff;
      }


      .header h2 {
        margin: 0;
        font-size: 30px;
        line-height: 1.3;
      }

      .content {
        padding: 28px 32px 20px;
      }

      .eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 10px;
      }

      p {
        margin: 0 0 18px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      .highlight {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #16a34a;
        border-radius: 12px;
        padding: 14px 16px;
        color: #166534;
        font-size: 14px;
      }

      .footer {
        padding: 0 32px 28px;
        text-align: center;
        font-size: 12px;
        color: #64748b;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="eyebrow">Security update</div>
        <h2>Password reset successful</h2>
      </div>

      <div class="content">
        <p>Hello <%= name %>,</p>
        <p>Your password has been changed successfully. You can now sign in to your PH Healthcare System account using your new password.</p>

        <div class="highlight">
          If you did not make this change, please contact support immediately to secure your account.
        </div>
      </div>

      <div class="footer">
        &copy; PH Healthcare System. All rights reserved.
      </div>
    </div>
  </body>
</html>
