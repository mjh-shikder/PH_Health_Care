<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Welcome to PH Healthcare System</title>
    <style>
      body {
        margin: 0;
        padding: 32px 16px;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, #eef6ff 0%, #f5f7fb 100%);
        color: #1f2937;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
        overflow: hidden;
        border: 1px solid #e5e7eb;
      }

      .header {
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
        padding: 28px 32px 22px;
        color: #ffffff;
      }

      .eyebrow {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 10px;
      }

      .header h2 {
        margin: 0;
        font-size: 28px;
        line-height: 1.3;
      }

      .content {
        padding: 30px 32px 26px;
      }

      p {
        margin: 0 0 18px;
        line-height: 1.7;
        font-size: 15px;
        color: #4b5563;
      }

      .note {
        background: #f8fafc;
        border-left: 4px solid #2563eb;
        border-radius: 10px;
        padding: 14px 16px;
        font-size: 14px;
        color: #475569;
      }

      .footer {
        padding: 0 32px 28px;
        font-size: 12px;
        color: #64748b;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <div class="eyebrow">Welcome</div>
        <h2>Welcome to PH Healthcare System</h2>
      </div>

      <div class="content">
        <p>Hello <%= name %>,</p>
        <p>Welcome to PH Healthcare System! We're glad to have you with us.</p>
        <p>Your account is ready. You can now sign in and get started.</p>

        <div class="note">
          Thank you for choosing PH Healthcare System for your healthcare needs.
        </div>
      </div>

      <div class="footer">
        &copy; PH Healthcare System. All rights reserved.
      </div>
    </div>
  </body>
</html>
